<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application android:label="销售拨号探索" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".DialAlarmReceiver" android:exported="false" />
        <!-- Development-only synthetic inbox; no real phone operations reachable here. -->
        <activity android:name=".SyntheticBridgeActivity" android:exported="true" />
        <activity android:name=".PhoneCapabilitiesActivity" android:exported="true" />
        <!-- Disabled until a newly authorized controlled test; never enabled by the app. -->
        <activity android:name=".ControlledCallActivity" android:enabled="false" android:exported="true" />
        <activity android:name=".ControlledReconcileActivity" android:enabled="false" android:exported="true" />
        <activity android:name=".DeviceGuardActivity" android:exported="true" />
        <activity android:name=".SyntheticLeaseActivity" android:exported="true" />
    </application>
</manifest>
